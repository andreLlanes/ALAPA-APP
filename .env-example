# Sentinel Hub / Copernicus Data Space (NDVI from Sentinel-2) 
SH_CLIENT_ID=
SH_CLIENT_SECRET=
SH_BASE_URL=https://sh.dataspace.copernicus.eu
SH_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# NASA Earthdata / LAADS (satellite covariate downloads)
EARTHDATA_USER=
EARTHDATA_PASS=
LAADS_TOKEN=

# OpenAQ API (ground-station ETL)
OPENAQ_API_KEY=

# Postgres Connection
PG_DSN="postgresql://user:YOUR_PASSWORD@host:port/database"